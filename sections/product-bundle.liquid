{{ 'product-bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-bundle.js' | asset_url }}" defer></script>

<div class="bundle" data-bundle>
  {%- if section.settings.heading != blank -%}
    <h2 class="bundle__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="bundle__items">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank and product.available -%}
        {%- assign variant = product.selected_or_first_available_variant -%}
        <label class="bundle__item" {{ block.shopify_attributes }}>
          <input
            type="checkbox"
            class="bundle__checkbox"
            data-variant-id="{{ variant.id }}"
            data-price="{{ variant.price }}"
            checked
          >
          {%- if product.featured_image -%}
            <img
              class="bundle__image"
              src="{{ product.featured_image | image_url: width: 200 }}"
              alt="{{ product.featured_image.alt | escape }}"
              width="100"
              height="100"
              loading="lazy"
            >
          {%- endif -%}
          <span class="bundle__info">
            <span class="bundle__title">{{ product.title }}</span>
            <span class="bundle__price">{{ variant.price | money }}</span>
          </span>
        </label>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.note != blank -%}
    <p class="bundle__note">{{ section.settings.note }}</p>
  {%- endif -%}

  <div class="bundle__footer">
    <span class="bundle__total" data-bundle-total></span>
    <button type="button" class="bundle__add" data-bundle-add>
      {{ section.settings.button_label | default: 'Add bundle to cart' }}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Product bundle",
  "tag": "section",
  "class": "section-product-bundle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently bought together"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Save time — add the whole set in one click."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add bundle to cart"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
